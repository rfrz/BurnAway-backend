datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  email            String       @unique
  password         String
  age              Int
  experience_years Float
  createdAt        DateTime     @default(now())
  predictions      Prediction[]
}

model Prediction {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id])

  dailyWorkHours   Float
  sleepHours       Float
  caffeineIntake   Int
  bugsPerDay       Int
  commitsPerDay    Int
  meetingsPerDay   Int
  screenTime       Float
  exerciseHours    Float
  stressLevel      Float

  result           String
  confidenceScore  Float

  createdAt        DateTime @default(now())
}
