datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String       @id @default(uuid())
  username         String       @unique
  email            String       @unique
  password         String
  tokenVersion     Int          @default(0)
  age              Int
  experience_years Float
  createdAt        DateTime     @default(now())
  predictions      Prediction[]
}

model Prediction {
  id                String   @id @default(uuid())
  user_id           String
  user              User     @relation(fields: [user_id], references: [id])

  daily_work_hours  Float
  sleep_hours       Float
  caffeine_intake   Int
  bugs_per_day      Int
  commits_per_day   Int
  meetings_per_day  Int
  screen_time       Float
  exercise_hours    Float
  stress_level      Float

  burnout_level     String
  confidence        Float
  stress_estimate   Float
  probabilities     Json
  advice            String

  created_at        DateTime @default(now())
}
